{
  "name": "record",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "bun scripts/dev.ts",
    "format": "vp fmt --write .",
    "knip": "knip",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "prepare": "vp config",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "knip": "latest",
    "turbo": "latest",
    "typescript": "^6.0.3",
    "vite": "^0.2.1",
    "vite-plus": "^0.2.1"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.18.0"
    }
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "arktype": "^2.2.1",
    "hono": "^4.12.27",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "^4.1.9",
    "vite-plus": "latest"
  }
}
